# SafeNet KZ Environment Configuration

# AI Provider: gemini | openai | groq | openrouter | deepseek
AI_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=

# Optional: OpenAI / Groq / OpenRouter API Key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gemini-3-flash-preview

# Database URL (SQLite default, can be postgresql://user:password@localhost/safenet)
DATABASE_URL=sqlite:///safenet.db

# Worker & Pipeline settings
# INLINE_ANALYSIS: 0 = fast ingestion with background worker (recommended); 1 = inline synchronous analysis
INLINE_ANALYSIS=0
ENTITY_HASH_SECRET=change-me-in-production
MEDIA_DIR=media
CLAIM_TIMEOUT_MINUTES=10
MAX_ATTEMPTS=3
