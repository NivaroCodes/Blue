# SafeNet KZ / Blue — Environment Configuration

# ---------------------------------------------------------------------------
# Backend API & AI Background Worker (Fly.io / Local)
# ---------------------------------------------------------------------------

# Fly http_service.internal_port and API PORT must both be 8000.
PORT=8000
HOST=0.0.0.0
# Local default; fly.toml sets PRODUCTION=1 and disables reload.
PRODUCTION=0
RELOAD=false

# PostgreSQL Database URL (mandatory - SQLite is forbidden in runtime)
# Local: postgresql+psycopg2://postgres:postgres@localhost:5432/safenet
# Fly: import the same DATABASE_URL secret for both process groups.
# Supabase: copy Direct IPv6 or Session pooler (5432) URI from Connect, percent-encode password.
# Require TLS: append ?sslmode=require&connect_timeout=10 (verify-full with trusted CA preferred).
# Do not use transaction pooler port 6543 or Supabase anon/service_role API keys.
# Supabase Free is not a private Fly network; see the owner decision gate in docs/DEPLOY_FLY.md.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/safenet
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safenet_test
# Small per-process connection pools for Supabase demo; same values in fly.toml.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300

# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Entity pseudonymization secret (used for HMAC hashing phone numbers, bank accounts)
ENTITY_HASH_SECRET=replace-with-secure-random-secret

# Ingestion API Bearer Token (protects POST /api/messages and POST /api/analyze-image)
# Required in deployed environments; fails closed if empty when deployed.
INGEST_API_TOKEN=replace-with-random-bearer-token

# Worker & Pipeline settings
INLINE_ANALYSIS=0
MEDIA_DIR=media
# Local development only: local. Separate Fly Machines MUST use r2.
MEDIA_STORAGE=local
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=blue-demo-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Operator-side URL for python run.py seed-demo; never place the ingestion token in VITE_*.
DEMO_API_URL=http://127.0.0.1:8000
CLAIM_TIMEOUT_MINUTES=10
MAX_ATTEMPTS=3
# Interval within a worker batch; tune to the model/account quota (not a global rate limiter).
WORKER_THROTTLE_SECONDS=4.5

# Allowed CORS origins (comma-separated; include your Cloudflare Pages domain in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://your-app.pages.dev

# ---------------------------------------------------------------------------
# Telegram Bot Connector (Voluntary private-chat submissions)
# ---------------------------------------------------------------------------

# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL of the FastAPI endpoint (e.g. https://your-blue-app.fly.dev/webhooks/telegram)
TELEGRAM_WEBHOOK_URL=https://your-domain.example/webhooks/telegram

# Secret token sent by Telegram in X-Telegram-Bot-Api-Secret-Token (1-256 chars, A-Za-z0-9_-)
TELEGRAM_WEBHOOK_SECRET=replace-with-random-url-safe-secret

# Secret key for HMAC pseudonymization of Telegram user IDs (never store raw Telegram user IDs)
TELEGRAM_HASH_SECRET=replace-with-a-different-random-secret

# Comma-separated list of numeric Telegram User IDs allowed to use the test bot.
# Fails closed: if empty or unconfigured, the bot denies all submissions.
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# Voluntary submission data retention policy
TELEGRAM_RETENTION_DAYS=30
TELEGRAM_RETENTION_SWEEP_SECONDS=3600

# ---------------------------------------------------------------------------
# Frontend (Cloudflare Pages / Local)
# ---------------------------------------------------------------------------

# Base API URL without trailing slash and WITHOUT '/api' (e.g. https://your-blue-app.fly.dev)
# Note: In Vite, VITE_* variables are baked into client-side JS. Never store secrets here.
VITE_API_BASE_URL=
VITE_DATA_MODE=api
