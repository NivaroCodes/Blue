# SafeNet KZ Environment Configuration

# Google Gemini API (from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL Database URL (mandatory - SQLite is forbidden in runtime)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/safenet
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safenet_test

# Worker & Pipeline settings
INLINE_ANALYSIS=0
ENTITY_HASH_SECRET=replace-with-secure-random-secret
MEDIA_DIR=media
CLAIM_TIMEOUT_MINUTES=10
MAX_ATTEMPTS=3

# Allowed CORS origins for local frontend development (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

