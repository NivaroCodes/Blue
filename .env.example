# SafeNet KZ Environment Configuration

# AI Provider: gemini | openai | groq | openrouter | deepseek
AI_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=

# Optional: OpenAI / Groq / OpenRouter API Key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gemini-3-flash-preview

# Database URL (SQLite default, can be postgresql://user:password@localhost/safenet)
DATABASE_URL=sqlite:///safenet.db
# For Supabase PostgreSQL use: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Analyst login: public Supabase Auth values are used by the backend to verify user sessions.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated frontend origins, for example https://blue-omnis-demo.pages.dev.
CORS_ORIGINS=
# Server-only credential for POST /api/messages and POST /api/analyze-image.
INGEST_API_TOKEN=

# Worker & Pipeline settings
INLINE_ANALYSIS=1
ENTITY_HASH_SECRET=change-me-in-production
MEDIA_DIR=media
# Fly API and worker run on separate machines; use shared R2 there.
# MEDIA_STORAGE=r2
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
CLAIM_TIMEOUT_MINUTES=10
MAX_ATTEMPTS=3

# Messaging webhooks (keep real values in Fly secrets or local ignored .env.local)
SENDER_HASH_SECRET=change-me-to-a-long-random-secret
TELEGRAM_HASH_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Exactly one dedicated group/supergroup ID. Telegram chat updates from other chat types are ignored.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_BASE_URL=https://your-app.fly.dev
TELEGRAM_WEBHOOK_URL=https://your-app.fly.dev/webhooks/telegram
GREEN_API_API_URL=
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
GREEN_API_WEBHOOK_TOKEN=
GREEN_API_ALLOWED_CHAT_ID=
