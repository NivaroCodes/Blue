# demo | api
VITE_DATA_MODE=demo
# Empty means same origin /api, proxied by Vite in development.
VITE_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:8000
# Public Supabase Auth configuration (safe for browser builds; never use a secret/service key here).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
