  "narrative": {
    "northStar": "The Daylit Analyst Workspace",
    "overview": "Blue is an operating workspace: a cool ground, white review surfaces, dark ink and a precise royal-blue accent. Message content, source context and review actions share one calm working field. This light direction replaces the previous dark orange identity.\n\nA folded lowercase b is the signature, shared by the vector mark and a lit extruded 3D form. Dimensional branding stays beside the analyst's work or inside a short, skippable entrance; review surfaces remain mostly flat. The generated concept supplies composition reference only; actual application data and implemented components define the shipped system.",
    "keyCharacteristics": [
      "Cool daylight surfaces and restrained royal-blue emphasis.",
      "Self-hosted Manrope with Cyrillic, Cyrillic extended and Latin glyph coverage.",
      "Dense message review with adjacent evidence and explicit human judgment.",
      "Finite animation, keyboard controls and a usable non-WebGL path."
    ],
    "rules": [
      {
        "name": "The Action and Evidence Rule",
        "body": "Blue marks navigation, actions and source identity. Risk colors describe labeled risk; yellow marks evidence text.",
        "section": "colors"
      },
      {
        "name": "The One Text Voice Rule",
        "body": "Use Manrope throughout the workspace and wordmark; reserve monospace for technical content and tabular numerals for comparable values.",
        "section": "typography"
      },
      {
        "name": "The Reserved Depth Rule",
        "body": "Keep review surfaces flat; reserve dimensional material for the b signature and genuine spatial source membership.",
        "section": "elevation"
      },
      {
        "name": "The Actual Membership Rule",
        "body": "An edge means a message belongs to a source; it must never imply an inferred account relationship or a fraud verdict.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** use the cool ground, white sheets and blue actions consistently across routes.",
      "**Do** keep message evidence, source context, risk labels and human review readable together.",
      "**Do** retain keyboard controls, source/message lists, reduced motion and vector fallbacks alongside 3D.",
      "**Do** show actual application counts and distinguish synthetic demonstration scores from evaluated model results."
    ],
    "donts": [
      "**Don't** reuse the discarded dark orange identity for new Blue surfaces.",
      "**Don't** turn the workspace into a landing-first 3D spectacle or repeat the entrance during SPA navigation.",
      "**Don't** introduce decorative glass cards, neon glow or stock robot imagery.",
      "**Don't** invent AI performance metrics, graph relationships or legal verdicts."
    ]
  }
}
